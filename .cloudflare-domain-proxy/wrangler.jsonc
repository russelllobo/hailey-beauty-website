{
  "name": "hailey-beauty-domain-proxy",
  "main": "worker.js",
  "account_id": "ac5cf54d4a48e8651a5ebe5727ff7ab4",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "haileybeauty.studio/*",
      "zone_id": "db38989a62bff30bd5ad04894144ca10"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.01
    }
  }
}
