{
  "name": "hailey-beauty-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler pages dev .dist --port 5181",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler pages deploy .dist --project-name hailey-beauty",
    "setup:cloudflare": "node scripts/cloudflare-setup.mjs",
    "test:browser": "node scripts/verify-analytics.mjs",
    "deploy:proxy": "wrangler deploy --config cloudflare/domain-proxy.wrangler.jsonc"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "wrangler": "^4.149.0"
  }
}
